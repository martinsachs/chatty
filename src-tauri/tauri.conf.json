{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chatty",
  "version": "0.2.3",
  "identifier": "io.github.martinsachs.chatty",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "chatty",
        "width": 1200,
        "height": 800,
        "label": "main",
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data: avatar: http://avatar.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Server-unabhängiger Chatclient",
    "licenseFile": "../LICENSE.txt"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxRDFFN0E2MTY3OTk5ODIKUldTQ21Ya1dwdWZSOFNORTVPcEhZVTBoV2RveGora290bTZhdEorVXpwQmNRaXhyVjAxWFpTT2kK",
      "endpoints": [
        "https://github.com/martinsachs/chatty/releases/latest/download/latest.json"
      ]
    }
  }
}
