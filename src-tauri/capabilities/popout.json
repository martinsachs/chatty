{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popout",
  "description": "Abgelöste Chatfenster: nur Links öffnen (http/https), kein Update/Neustart",
  "windows": ["space-*"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
